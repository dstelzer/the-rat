%% Web styling

(style class @body)
	--font-status: Geneva, sans-serif;
	--font-body: Geneva, sans-serif;
(startup)
	(body style @body)

(platform) Å-machine

(style class @rat)
	border-top: 2px solid goldenrod;
	border-left: 2px solid goldenrod;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @ratcolor)
	color: goldenrod;

(style class @spider)
	border-top: 2px solid deepskyblue;
	border-left: 2px solid deepskyblue;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @spidercolor)
	color: deepskyblue;

(style class @jackdaw)
	border-top: 2px solid green;
	border-left: 2px solid green;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @jackdawcolor)
	color: green;

(style class @chameleon)
	border-top: 2px solid magenta;
	border-left: 2px solid magenta;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @chameleoncolor)
	color: magenta;

(style class @guests)
	border-top: 2px dashed \#888888;
	border-left: 2px dashed \#888888;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
(style class @butlercolor)
	color: inherit;
(conversation style description) dotted gray (line) all the colors are taken it's time for patterns

(style class @mainstatus)
	height: auto;
	font-size: 1.2em;
	line-height: 1em;
	margin-top: 0.33em;
	margin-bottom: 0.33em;
	position: relative;

(style class @hr)
	height: 0.1em;
	width: 100\%;
	background-color: var\(--text\);
	aria-role: separator;
	margin-top: 0.5em;
	margin-bottom: 0.5em;
(hr)
	(div @hr) (space 1)
