%% The whole “actions” section of stdlib.dg was excised and moved to actions_base.dg
%% Then the parts that are wanted for this game were moved over here
%% This means:
%% - TELL (Fox)
%% - WAIT (Fox)
%% - - LONG WAIT (Fox)
%% - Commands (Fox)

%% - GO (Rat, Chameleon)
%% - SABOTAGE (Rat)

%% - PROCEED (Jackdaw)
%% - SCORE (Jackdaw)

%% - LOOK (Spider)
%% - EXAMINE (Spider)
%% - HACK (Spider)

%% - MINGLE (Chameleon)
%% - DISENGAGE (Chameleon)
%% - LOOP (Chameleon)

%% - TAKE (Butler)
%% - DROP (Butler)
%% - ATTEND TO (Butler)

%% We also preserve two pieces of special syntax in stdlib.dg
%% Bare directions for GO; and ACTOR, ACTION for TELL ACTOR TO ACTION

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Commands

(interface (command $<Action))

@(understand command $Action)
	(understand $Action)
	(command $Action)

(describe action (command $Action))
	issue the (exhaust) { *($Word is one of $Action) $Word } command

%% QUIT

(command [quit])
(understand [quit/q] as [quit])
(prevent [quit])
	~(interpreter supports quit)
	(div @meta) { In this interpreter, close the window to quit the game. }
(perform [quit])
	(div @meta) { Really quit? \(y (no space) / (no space) n\) }
	(if) (yesno) (then)
		(div @meta) (display quit message)
		(quit)
	(endif)
	(stop)

(display quit message)
	Thanks for playing!

%% RESTART

(understand command [restart])
(perform [restart])
	(div @meta) {
		Restart the game from the beginning? \(
		(if) (library links enabled) (then) (link) y (else) y (endif)
		(no space) / (no space)
		(if) (library links enabled) (then) (link) n (else) n (endif)
		\)
	}
	(if) (yesno) (then)
		(restart)
		(div @meta) { Failed to restart. }
	(endif)
	(stop)

%% SAVE

(understand command [save])
(perform [save])
	(if) (save $ComingBack) (then)
		(if) ($ComingBack = 1) (then)
			(roman)
			(div @meta) { Game state restored successfully. }
			(div @roomheader) (location headline)
		(else)
			(div @meta) { Game state saved successfully. }
		(endif)
	(else)
		(div @meta) { Failed to save the game state. }
	(endif)
	(stop)

%% RESTORE

(understand command [restore])
(perform [restore])
	(restore)
	(div @meta) { Failed to restore the game state. }
	(stop)

%% UNDO

(command [undo])
(perform [undo])
	(if) ~(interpreter supports undo) (then)
		(div @meta) { This interpreter doesn’t support undo. }
	(elseif) (undo) (then)
		(div @meta) { Failed to undo last turn. }
	(else)
		(div @meta) { There are no more turns to undo! }
	(endif)
	(stop)

(narrate undoing $Words)
	(div @meta) { Undoing the last turn \( (print words $Words) \). }
	(line)
	(location headline)

%% TRANSCRIPT

(command [transcript on])
(understand [transcript/script on] as [transcript on])
(understand [transcript/script] as [transcript on])

(perform [transcript on])
	(div @meta) {
		(if) (transcript on) (then)
			Transcript enabled.
		(elseif) (transcript active) (then)
			%% Do nothing, transcripting is already active
		(else)
			Failed to enable transcript.
			(stop)
		(endif)
	}

(command [transcript off])
(understand [transcript/script off] as [transcript off])

(perform [transcript off])
	(transcript off)
	(div @meta) { Transcript disabled. }

%% SCORE

%% Disabled, see below

%% NOTIFY

%% Disabled, see below

%% VERBOSE / BRIEF / SUPERBRIEF / SUPERVERBOSE

%% Disabled

%% VERSION

%% Moved to meta.dg

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Fox

%% TELL <obj> TO | <action>

(understand [tell/ask | $Words] as [tell $Actor to | $Action])
	*(split $Words by [, to] into $Left and $Right)
	*(understand $Left as single object $Actor preferably animate)
	(current actor $OldActor)
	(now) (current actor $Actor)
	(rewrite $Right into $Simplified)
	(collect $A)
		*(understand $Simplified as $A)
	(into $List)
	(now) (current actor $OldActor)
	*($Action is one of $List)

(understand [ask | $Words] as [tell $Actor to give $Obj to $Player])
	*(split $Words by [for] into $Left and $Right)
	*(understand $Left as single object $Actor preferably animate)
	*(understand $Right as object $Obj preferably child of $Actor)
	(current player $Player)

%% The rule for “name comma action” is further down in the file.

(unlikely [tell $Addressee to | $])
	~(animate $Addressee)

(describe action [tell $Actor to give $Obj to (current player $)])
	ask (the full $Actor) for (the full $Obj)

(describe action [tell $Actor to tell (current player $) about $Topic])
	ask (the full $Actor) about (describe topic $Topic)

(describe action [tell $Actor to | $Action])
	tell (the full $Actor) to (describe action $Action)

(unlikely [tell $Obj to | $])
	~(animate $Obj)

(action [tell $NPC to | $] requires $NPC to be present) (just)
~(action [tell $ to | $] requires $ to be touched)

(instead of [tell $NPC to greet])
	(try [greet $NPC])

(instead of [tell $NPC to tell (current player $) about $Topic])
	(try [ask $NPC about $Topic])

(perform [tell $Actor to | $])
	(div @spider) { It does not seem that (the $Actor) will take orders from us. }

(action [tell $ to | $] is valid for *(protagonist $))

%% WAIT (and LONG WAIT)

(grammar [wait/z] for [wait])
(grammar [long wait/z] for [long wait])
(grammar [long/lz] for [long wait])

(perform [wait])
	(heist in progress)
	~(long wait unlocked)
	(div @chameleon) { I imagine there will be quite a lot of waiting while Jackdaw does her work. }
	(div @spider) { That is true. I suppose we should make it clear whether the intent is to wait for one minute or to wait until Jackdaw’s heist is complete. }
	(div @jackdaw) { just use different words (line) wait vs long wait }
	(div @spider) { I suppose that is as good a convention as any. We can adopt it. }
	(now) (long wait unlocked)
	(now) (no quip this turn)

(perform [wait])
	(select)
		(if) (current act 4) (then)
			(div @jackdaw) { this is where chameleon would say something }
		(else)
			(div @chameleon) { So, darling, what comes next? }
		(endif)
	(or)
		(div @jackdaw) { dot dot dot }
	(or)
		(div @spider) { All systems ready. }
	(or)
		(div @rat) { The rat waits. }
	(at random)

(prevent [long wait])
	~(heist in progress)
	(div @spider) { But there is no heist in progress. }

(perform [long wait])
	(now) (long wait unlocked) %% In case the dialogue hasn’t happened yet
	(div @spider) { We shall wait. }
	*(repeat forever)
	(hr)
	(tick)
	~(heist in progress) %% Fail and jump back to the *(repeat forever) if the heist is still ongoing

(action [wait] is valid for *(protagonist $)) %% All characters can do it
(action [long wait] is valid for *(protagonist $))

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Rat

%% Navigation by direction:

%% What the player types is eventually translated into one of:

%% [leave $Room $Dir]
%% [leave $Room $Dir by $Vehicle]
%% [leave $Room $Dir with $Obj]

%% These are generally the ones to override/extend.

%% The default rules for the aforementioned actions invoke ‘(prevent entering
%% $Room)’ and ‘(narrate entering $Room)’. These predicates can of course also
%% be overridden. Thus, entering a room is not an action of its own, but is
%% an inherent part of leaving a room.

%% GO <direction>

%% The rule for just typing a list of directions (without a verb) is in stdlib.dg

(grammar [go/walk/crawl/leave/get/climb [direction]] for [go $])
(grammar [go/walk/crawl [to further] [direction]] for [go $])
(grammar [go/walk/crawl] for [go #out])
(grammar [enter] for [go #in])

(unlikely-complex [go $DirList] 0)
	(just)
	(if) (direction $DirList) (then)
		($Dir = $DirList)
	(else)
		%% Only consider the first direction in the list.
		([+ $Dir | $] = $DirList)
	(endif)
	(unlikely [go $Dir])

(unlikely [go $Dir])
	(current player $Actor)
	($Actor is in room $Room)
	~{
		(from $Room go $Dir to $Target)
		{ (room $Target) (or) (door $Target) (or) (direction $Target) }
	}

(perform [go $Dir])
	(current player $Actor)
	($Actor is in room $Room)
	(if) ($Actor has parent $Room) (then)
		(try [leave $Room $Dir])
	(else)
		($Actor has parent $Vehicle)
		(try [leave $Room $Dir by $Vehicle])
	(endif)

%% LEAVE <room> <dir>
%% LEAVE <room> <dir> BY <vehicle>
%% LEAVE <room> <dir> WITH <object>

(instead of [leave $Room $Dir])
	(from $Room go $Dir to $Target)
	(direction $Target)
	(try [leave $Room $Target])

(prevent [leave $Room $Dir])
	(if) (from $Room go $Dir to $Target) (then)
		(if) (door $Target) (then)
			{
				(when $Target blocks passage)
			(or)
				(from $Room through $Target to $OtherRoom)
				(prevent entering $OtherRoom)
			}
		(elseif) (room $Target) (then)
			(prevent entering $Target)
		(else)
			(narrate failing to leave $Room $Dir)
		(endif)
	(else)
		(if) ($Dir is one of [#out #in]) (then)
			(if) (current player #rat) (then)
				(div @rat) { The rat will go. But which way? }
			(else)
				(div @chameleon) { Yes, but which way exactly? }
			(endif)
			(asking for direction in [go []])
		(else)
			(narrate failing to leave $Room $Dir)
		(endif)
	(endif)

(narrate leaving $ $) %% $Room $Dir
	(current player #rat)
	(div @rat) {
		(select)
			The rat
		(or)
			It
		(or)
			The rat, it
		(then purely at random)
		(select)
			moves
		(or)
			goes
		(or)
			is moving
		(or)
			is going
		(purely at random)
		.
	}

(narrate failing to leave $ $)
	(if) (current player #rat) (then)
		(div @rat) { The rat cannot. No path is there. }
	(elseif) (current player #chameleon) (then)
		(div @chameleon) { I would love to, but I’m afraid I just can’t see how. }
	(else)
		(div @spider) { The butler shakes his head slightly. }
	(endif)

(perform [leave $Room $Dir])
	(narrate leaving $Room $Dir)
	(from $Room go $Dir to room $Target)
	(if) (current player #chameleon) (people are following) (then)
		(move #crowd to $Target)
	(endif)
	(enter $Target)

(action [go/leave | $] is valid for #rat/#chameleon)
(action [go/leave | $] is valid for #butler) (butler has the earpiece)

%% SABOTAGE <obj>

(grammar [sabotage/break/wreck [single]] for [sabotage $])
(grammar [sabotage/break/wreck] for [sabotage])

(instead of [sabotage]) %% Short form requested by testers
	(#rat is in room $Room)
	(if) *($Obj has ancestor $Room) (sabotage target $Obj) (then)
		(try [sabotage $Obj])
	(else)
		(div @rat) { But what is to sabotage? }
		(tick) (stop)
	(endif)

(prevent [sabotage $])
	(#rat is in room $Room)
	(occupied $Room)
	(div @rat) { No! The rat cannot! It would be seen! }

(prevent [sabotage $])
	(heist in progress)
	(div @jackdaw) { hey wait no not yet (line) dont draw the butlers attention while im actively robbing the place (line) do all the sabotaging you want and (span @italic) then tell me to proceed }
	(select)
		(div @spider) { That seems quite limiting. }
		(div @jackdaw) { well if you dont like it then come do it yourself (line) i cant avoid cameras and steal everything at the same time }
		(div @rat) { But much can be sabotaged before the proceeding. }
	(or)
	(stopping)

(prevent [sabotage ~(sabotage target $Obj)])
	(div @rat) { The rat assesses. But (the $Obj) , (it $Obj) offer(s $Obj) nothing. No means of destruction. }

(perform [sabotage $Obj])
	(narrate sabotaging $Obj)
	(now) ($Obj is broken)

(narrate sabotaging $Obj) %% Fallback
	(div @rat) { (The $Obj) , (it $Obj) yield(s $Obj). (It $Obj) open(s $Obj). (It $Obj) break(s $Obj). }

(action [sabotage | $] is valid for #rat)

(after [examine (sabotage target $Target)])
	(if) ($Target is broken) (then)
		(div @rat) { Damaged. In need of repair. }
	(else)
		(div @rat) {
			Vulnerable.
			(select)
				(It $Target) could be opened. Changed.
			(or)
			(stopping)
		}
	(endif)

%% Object manipulation (not actually possible)

(grammar [i/inventory] for [inventory])
(grammar [take inventory] for [inventory])
(grammar [take/get [takable]] for [take $])
(grammar [drop [held]] for [drop $])

(action [inventory/take/drop | $] is valid for #rat/#chameleon)
(action [inventory/take/drop | $] is valid for #butler) (butler has the earpiece)

(prevent [inventory/take/drop | $])
	(current player #rat)
	(div @rat) { The rat carries nothing. No tools. No treasures. No carrying evidence. It works with its hands. }

(prevent [inventory/take/drop | $])
	(current player #chameleon)
	(div @chameleon) { I’m afraid this costume gives me very little opportunity for messing with anything. I’m here to use my words, not my hands. }

(perform [inventory])
	(current player #butler)
	(if) ($Obj is #heldby #butler) (then)
		(div @spider) { The butler glances at (the $Obj) in his hands. }
	(else)
		(div @spider) { The butler glances briefly at his empty hands. }
	(endif)

(prevent [take/drop | $])
	(current player #butler)
	(div @spider) { Your meaning seems obvious, but apparently those are not the right words. Try “attend to” something instead. }

%% HIDE (not useful)

(grammar [hide] for itself)
(prevent [hide])
	(div @rat) { Do not need to tell. When people come, the rat hides. When people leave, it emerges. }

(action [hide] is valid for #rat)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Jackdaw

(grammar [proceed/start/begin] for [proceed])

(prevent [proceed])
	(current act 0)
	(#butler is in room #garden1)
	(div @jackdaw) { like i said (line) get the butler out of the way first }

(prevent [proceed]) %% The time for proceeding has passed
	(current act 4)
	(div @jackdaw) { i’m on my way out now (line) don’t want to be in the middle of the guests’ stuff when they leave }

(perform [proceed])
	(current act 0)
	(div @jackdaw) { on it }
	(div @spider) { She is in! }
	(div @jackdaw) { down in the basement ready to rob this place blind (line) just need a distraction }
	(div @spider) { Now find a way to get Rat in, and we will have one. }
	(now) (jackdaw has entered)

(prevent [proceed])
	(heist in progress)
	(div @jackdaw) { im already proceeding you dont have to tell me again }

(prevent [proceed])
	(current act $Act)
	($Act > 0)
	~(any prizes left in act $Act)
	(div @jackdaw) { love the opportunity but theres nothing left to nab here }

(prevent [proceed])
	~(current goal $)
	(div @jackdaw) { if the butler looks at the cameras now he’ll see me right away (line) make a distraction or something first }

(perform [proceed])
	(start the heist)
	(div @jackdaw) {
		(select)
			roger
		(or)
			on it
		(or)
			proceeding
		(or)
			thats a go
		(or)
			lets go
		(at random)
	}

(action [proceed] is valid for #jackdaw)

%% Not quite an action but similar to one - this is called from prizemachinery.dg

(heist succeeds with result $Time)
	(div @spider) {
		(select)
			He is accessing the security. Jackdaw, get out!
		(or)
			Security is being checked again.
		(or)
			(select)
				Time.
			(or)
				Time is up.
			(or)
				Security active again.
			(at random)
		(stopping)
	}
	(div @jackdaw) {
		(select)
			out (line) with seconds to spare (line) how long was that?
		(or)
			im out (line)
			time?
		(or)
			(select)
				done
			(or)
				out
			(or)
				thanks
			(at random)
		(stopping)
	}
	(div @spider) {
		(select)
			The butler was distracted for
		(or)
			Security was down for
		(or)
			That distraction lasted
		(or)
		(or)
			That was
		(then at random)
		$Time minute(s $Time).
	}
	(current act $Act)
	(if)
		($Time turns in act $Act earns $Prize)
	(then) %% Got a prize!
		(div @jackdaw) {
			grabbed (a $Prize)
			(if) ($Prize is worth $K thousand dollars) (then)
				(line)
				estimated value ($K thousand dollars)
			(endif)
		}
		(prize conversation about $Prize)
		(if) ~(any prizes left in act $Act) (then)
			(div @jackdaw) {
				also thats pretty much everything for this room (line)
				scoured it clean (line)
				(if) ($Act < 4) (then)
					see if you can get me into the next one
				(else)
					anything else or are we done here?
				(endif)
			}
		(endif)
	(else) %% No prizes left for that timespan :(
		{ (minimum time for a prize in $Act is $MinTime) (or) ($MinTime = 9999) }
		(div @jackdaw) { ------ (line) couldnt grab anything (line) the easy stuffs gone now, i need more time (line) like $MinTime minute(s $MinTime) at least }
		%% 9999 shouldn’t happen but it’s a funny default if this slips through
	(endif)
	(now) (no quip this turn) %% There’s been enough conversation that we don’t want an extra quip on top of it

%% Overload these predicates for number -> noun as well as noun -> verb
%% Someday I want to put this into the standard library proper
(s 1)
(s (number $)) (no space)s

(grammar [score] for itself)

(prevent [score])
	(current act 0)
	(div @jackdaw) { i havent scored anything yet (line) get me in the building first }

(prevent [score])
	~{
		*(prize $Prize)
		($Prize is handled)
	}
	(div @jackdaw) { havent scored anything yet (line) get the butler distracted and then tell me when }

(perform [score])
	(div @jackdaw) {
		ok heres what ive got
		(accumulate $K)
			*(prize $Prize)
			($Prize is handled)
			(if) ($Prize is worth $K thousand dollars) (then)
				(line) (name $Prize) (space) - (space) ($K thousand dollars)
			(elseif) (personal treasure $Prize) (then)
				(line) (name $Prize)
				($K = 0)
			(else) %% otherwise just fail: for things like the wifi router
				(fail)
			(endif)
		(into $Total)
		(line) for a total of (span @bold) ($Total thousand dollars)
		(line) (assess the value of $Total)
	}

(assess the value of $N)
	that means ($N thousand dollars divided by five) each (line)
	we’re each getting
	*(count down from $N into $K)
	(what $K thousand total can buy)

(what 1 thousand total can buy) new shoes %% 200 each
(what 2 thousand total can buy) new tech %% 400 each
(what 5 thousand total can buy) our rent covered %% 1,000 each
(what 10 thousand total can buy) a nice vacation %% 2,000 each
(what 20 thousand total can buy) some home upgrades %% 4,000 each
(what 50 thousand total can buy) a car %% 10,000 each
(what 75 thousand total can buy) a better car %% 15,000 each
(what 100 thousand total can buy) our debts paid off %% 20,000 each
(what 150 thousand total can buy) whatever we want %% 30,000 each

%% N × 1,000 / 5 = N × 200 = (N×2) with two zeroes
($N thousand dollars divided by five)
	\$ (no space)
	($N times 2 into $Tmp) %% This is our end result divided by 100
	($Tmp divided by 10 into $Thousands)
	($Tmp modulo 10 into $Hundreds)
	(if) ($Thousands > 0) (then)
		$Thousands
		, (no space)
	(endif)
	$Hundreds
	(no space) 00

%% N × 1,000 / 6 = N×500×2/6 = N×500/3 = (N×5)/3 with two extra digits
($N thousand dollars divided by six with remainder $Mod3)
	\$ (no space)
	($N times 5 into $Nt5)
	($Nt5 divided by 3 into $Tmp) %% As above this is our end result divided by 100
	($Nt5 modulo 3 into $Mod3)
	($Tmp divided by 10 into $Thousands)
	($Tmp modulo 10 into $Hundreds)
	(if) ($Thousands > 0) (then)
		$Thousands
		, (no space)
	(endif)
	$Hundreds
	(no space)
	(if) ($Mod3 = 0) (then)
		00
	(elseif) ($Mod3 = 1) (then)
		33.33
	(elseif) ($Mod3 = 2) (then)
		66.67
	(endif)

(action [score] is valid for #jackdaw)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Spider

%% LOOK

(default action $Obj [examine $Obj])
(narrate entering $Room) (try [examine $Room])

(describe room $Room)
	(select)
		Looking at Rat’s location...
	(or)
	(stopping)
	(div @roomheader) { (span @bold) (room header $Room) }
	(look $Room)
	(make appearances #in $Room)
	(par)

(understand [examine/x/watch/describe/check/look/l/view | $Words] as [examine $Room])
	(understand $Words as room name $Room)
(understand [look/l at | $Words] as [examine $Room])
	(understand $Words as room name $Room)

(understand [l/look] as [look])
(instead of [look])
	(current player $Player)
	($Player is in room $Room)
	(try [examine $Room])

(understand $Words as room name $Room)
	(filter $Words into $Filtered)
	(nonempty $Filtered)
	(determine object $Room)
		*(room $Room)
		{ ($Room is visited) (or) (in bounds for this act $Room) }
	(from words)
		*(dict $Room)
	(matching all of $Filtered)

(prevent [examine (room $Room)])
	~(in bounds for this act $Room)
	(if) ($Room is visited) (then)
		(div @spider) { Not relevant at the moment. }
	(else)
		(div @spider) { For the moment, I am afraid I have no eyes there. }
	(endif)

(perform [examine (room $Room)])
	(div @spider) (describe room $Room)

(add $Everything to scope)
	*(in bounds for this act $Room)
	($Everything = $Room) (or) *($Everything has ancestor $Room)

%% EXAMINE <obj>

(default actions enabled)
(default actions apply to rooms)
(default action $Obj [examine $Obj])

(grammar [examine/x/watch/describe/check/look/l/view [object]] for [examine $])
(grammar [look/l at [object]] for [examine $])

~(refuse [examine $]) %% Don’t require presence, much less touch - that’s a change from the default

(perform [examine ~(room $Obj)])
	(div @spider) {
		(descr $Obj)
		(if) (supporter $Obj) (then)
			(exhaust) {
				*($Child is #on $Obj)
				(par)
				(appearance $Child #on $Obj)
				(notice $Child)
			}
		(endif)
		(if) (container $Obj) ~{ (opaque $Obj) ($Obj is closed) } (then)
			(exhaust) {
				*($Child is #in $Obj)
				(par)
				(appearance $Child #in $Obj)
				(notice $Child)
			}
		(endif)
		(par)
	}

(action [examine $] is valid for #rat/#chameleon/#spider)
(action [examine $] is valid for #butler) (butler has the earpiece)
(unlikely [examine $]) (current player #butler) %% Avoid disambiguation with “a tray”

(add $Obj to scope)
	*(in bounds for this act $Room)
	*($Obj has ancestor $Room)

%% HACK <obj>

(grammar [hack [single]] for [hack $])
~(action [hack $] requires $ to be touched)
(add *(hack target $) to scope)

(prevent [hack ~(hack target $Obj)])
	(div @spider) {
		I am not seeing anything about (the $Obj) that I can access remotely.
	}

(grammar [hack] for itself)
(instead of [hack])
	(if) (hack target $Target) (then)
		(try [hack $Target])
	(else)
		(div @spider) { No vulnerabilities currently present themselves. }
		(tick) (stop)
	(endif)

%% No default PERFORM rule

(action [hack | $] is valid for #spider)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Chameleon

%% MINGLE

(grammar [mingle/socialize] for [mingle])

(before [mingle]) (now) (tried mingling) %% Whether it succeeds or fails

(prevent [mingle])
	(people are following)
	(div @chameleon) { As much as I love hearing your voice, darling, you don’t have to tell me twice. They’re hanging on my every word. }
	(div @jackdaw) { what voice this is all happening in text }

(prevent [mingle]) %% So many other quips depend on this one, we need to push it to happen early
	(#q-3-alisa is unvisited)
	(div @chameleon) { I would love to, darling, but propriety demands that I should really be greeted by the butler first. Give him a moment to find me,
	(if) ($ is broken) (then)
		without any sabotage,
	(endif)
	and I’m sure he will. }
	(now) ~(delay selection by one tick) %% Ensure the quip selection happens soon

(prevent [mingle])
	(#chameleon is in room $Room)
	~(#crowd is in room $Room)
	(div @chameleon) { I would love nothing more, darling, but I’m afraid there is nobody else around to mingle with. I’ll need to return to the party first. }

(perform [mingle])
	(div @chameleon) {
		(select)
			(uppercase)
		(or)
			As always,
		(stopping)
		your wish is my command. Give me just a moment to slip into the conversation
		(select)
			and they’ll follow me wherever I go
		(or)
		(stopping)
		.
	}
	(now) (people are following)

@(people are not following) ~(people are following)

(action [mingle] is valid for #chameleon)

%% DISENGAGE

(grammar [disengage/separate] for [disengage])

(prevent [disengage])
	(people are not following)
	(if) (#chameleon is in room $Room) (#crowd is in room $Room) (then)
		(div @chameleon) { Consider it done. I’m at the edge, ready to slip away. }
	(else)
		(div @chameleon) { Unless you’d like me to turn off the earpiece, dear, there’s nothing for me to disengage from. }
	(endif)

(perform [disengage])
	(div @chameleon) { No sooner said than done. I’m all yours again. }
	(now) (people are not following)

(action [disengage] is valid for #chameleon)

%% LOOP
%% Added to hopefully speed up the pace of act 3 and make it drag a bit less

(current world state for loop tracking is [$C $B])
	(#chameleon is in room $C)
	(#butler is in room $B)

%% This tracks whether the world has been in the same sequence of states over and over
%% If so, allow LOOP
(global variable (loop tracker $))

(after [proceed]) %% Reset it every time
	(now) (loop tracker [])

(looping allowed) %% If we’ve had an alternating sequence of states, allow the loop
	(loop tracker [$A $B $A $B | $])
	($A = [$ChamA $])
	~($B = [$ChamA $])
(looping allowed)
	(already looped once) %% Make it a bit faster after the first time
	(loop tracker [$A $B $A | $])
	($A = [$ChamA $])
	~($B = [$ChamA $])

(update the loop tracker)
	(current world state for loop tracking is $New)
	(loop tracker $Prev)
	(now) (loop tracker [$New | $Prev])
	(if) (loop tracker [$A $B $C $D | $]) (then) %% Trim to first four entries
		(now) (loop tracker [$A $B $C $D])
	(endif)
	(if) (looping allowed) (then)
		(select)
			(explain looping)
		(or)
		(stopping)
	(endif)

(on every tick)
	(update the loop tracker)

%% Now for the action!

(grammar [loop] for itself)

(prevent [loop])
	~(heist in progress)
	(div @chameleon) { I’d love nothing more than to keep doing this all night, darling, but shouldn’t you have Jackdaw do something first? }
(prevent [loop])
	~(looping allowed)
	(div @spider) { I do not think we have a stable loop here—a consistently repeating state. }

(perform [loop])
	(div @chameleon) { Understood. I will endeavor to repeat this until Jackdaw says otherwise. }
	(select)
		(div @jackdaw) { so (line) spider (line) hacked any good systems lately }
	(or)
		(div @spider) { Rat, stay in place for as long as you can. }
	(or)
		(div @rat) { Around and around. Around and around. }
	(at random)
	(maximum turns required for any prize ever is $Max)
	(heist timer $Old)
	(if) ($Old < $Max) (then)
		(now) (heist timer $Max)
		($Max minus $Old into $Delay)
		(hr)
		(div @jackdaw) { okay that should be good (line) you can let him go now i need to reset }
		(div @spider) { That was (spell out $Delay) minute (if) ~($Delay = 1) (then) (no space)s (endif) of delay. }
	(else)
		(div @jackdaw) { actually wait i think i got this don’t worry about it }
		(div @spider) { Well. All right then. }
	(endif)
	(now) (already looped once) %% Relax the requirements for next time

(action [loop] is valid for #chameleon)

(explain looping)
	(div @spider) { I think I see what you intend. That Chameleon should alternate between those two states, keeping the butler occupied indefinitely? }
	(div @jackdaw) { i like indefinitely }
	(div @spider) { If so, you may as well ask her to (vlink {LOOP}) her last few actions until Jackdaw is ready. }

%% GO

(narrate leaving $Src $Dir)
	(current player #chameleon)
	(from $Src go $Dir to $Dest)
	(if) (people are following) (then)
		(div @spider) {
			(select)
				Chameleon is winking at the camera and swirling away, and the crowd is following her.
			(or)
				Everyone is following Chameleon to (the $Dest) .
			(or)
				Chameleon is leading the crowd (name $Dir) .
			(or)
				The party is moving (name $Dir) (no space) ward with Chameleon.
			(then at random)
		}
	(else)
		(div @chameleon) {
			(select)
				Consider it done.
			(or)
				On my way.
			(or)
				As you wish.
			(or)
				Anything you say.
			(at random)
		}
	(endif)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Butler

%% ATTEND TO

(grammar [attend to [single]] for [attend to $])
(grammar [a [single]] for [attend to $])
(prevent [attend to ~(attend target $Obj)])
	(div @spider) {
		The butler shakes his head very slightly.
		(if) ($Obj is broken) (then)
			The time for fixing (the $Obj) is past. %% Just in case
		(elseif) (animate $Obj) (then)
			The time for attending to guests is past. %% For players of the original game
		(else)
			There must be nothing to do for (the $Obj).
		(endif)
	}

(attend target *(item $Obj))
(perform [attend to $Obj])
	($Obj is #heldby #butler)
	(#butler is in room $Room)
	(div @spider) { The butler puts down (the $Obj) . }
	(now) ($Obj is #in $Room)
(perform [attend to $Obj])
	(item $Obj)
	~($Obj is #heldby #butler)
	(if) ($Other is #heldby #butler) (then)
		(div @spider) { The butler gestures subtly to (the $Other) . }
		(tick) (stop)
	(else)
		(div @spider) { The butler picks up (the $Obj) . }
		(now) ($Obj is #heldby #butler)
	(endif)

(action [attend to $] is valid for #butler) (butler has the earpiece)

%% FIX (not accessible to the player, only used internally)

(narrate fixing $Obj) %% Fallback - individual objects should have their own descriptions
	(div @spider) { The butler is working on repairing (the $Obj) . }

%% GO

(narrate leaving $ $Dir)
	(current player #butler)
	(div @spider) { The butler is moving (name $Dir) . }

%% Since we cut out a bunch of stdlib machinery, we need to silence some compiler warnings here too; none of these are ever queried so they’ll be cut by dead code elimination
(interface (when $< is already held))
(interface (when $< is already worn))
(interface (when $< isn’t directly held))
(interface (when $< is part of something))
(interface (when $< is held by someone))
(interface (when $< is worn by someone))
(interface (when $< is fine where it is))
(interface (when $< can’t be taken))
(interface (when $< is $< $<))
