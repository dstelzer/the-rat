#q-1-guestlist
(quip *)
(* involves #t-malatesta/#t-tension/#t-constantine)
(* has priority $N) %% Raise the priority as more quips are visited until it becomes inevitable
	(accumulate 2)
		*(quip $Quip)
		($Quip is visited)
	(into $N)
	($N > 0) %% Fall back to 1 if this would produce 0
(* line)
	(div @spider) { Do we have confirmation of the final guest list? }
	(div @rat) { The doctor. Malatesta. He (if) (current act 1) (then) will be (else) is (endif) there. }
	(div @chameleon) { Ari Tension, the new owner and editor of the New Gothenburg Post. }
	(div @jackdaw) { that industrialist (line) constantine quinn }
	(div @chameleon) { And of course, me. }
	(div @spider) { Once I have added you to the list, yes. Which is waiting on Jackdaw. }
	(div @jackdaw) { working on it hold your horses (line) just buy me time }
(force *) (current act 2) %% Should never happen given the inevitability counter but just in case

