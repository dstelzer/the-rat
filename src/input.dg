%% input.dg: how the player actually gives commands to the different characters

(prevent [tell $Actor to | $])
	~(protagonist $Actor)
	TODO not a protagonist

(perform [tell $Actor to | $Action])
	(now) (actor was explicitly indicated)
	(select player $Actor)
	(try $Action)

(late on every tick) %% The mark only lasts one turn
	(now) ~(actor was explicitly indicated)

(instead of $Action)
	(current player $Actor)
	~(action $Action is valid for $Actor)
	(if) (actor was explicitly indicated) (then)
		Error message
	(else)
		(collect $Option) %% Who could that action be meant for?
			*(action $Action is valid for $Option)
		(into $Options)
		
		(collect $Option)
			*($Option is one of $Options)
			~($Option is nowhere)
		(into $OnStage)
		
		(if) (empty $Options) (then)
			Uh oh! Action (describe action $Action) is not valid for anyone! Please report!
		(elseif) ($Options = [$Single]) (then)
			Assume you're talking to (the $Single)...
			(try [tell $Single to | $Action])
		(elseif) ($OnStage = [$Single]) (then)
			Assume you're talking to (the $Single); it's ambiguous, but only they are on-stage...
			(try [tell $Single to | $Action])
		(else)
			Uh oh! Ambiguity! Did you mean (or-listing $Options)?
		(endif)
	(endif)
