%% OPEN <obj>

(grammar [open/unwrap/uncover [object]] for [open $])

(unlikely [open $Obj])
	~(openable $Obj) (or) ($Obj is open)

(before [open $Obj])
	($Obj is closed)
	($Obj is locked)
	(current player $Player)
	*($Key is nested #heldby $Player)
	($Key unlocks $Obj)
	~($Key is hidden)
	(first try [unlock $Obj with $Key])

(prevent [open $Obj])
	~(openable $Obj)
	(The $Obj) (doesn't $Obj) open.

(prevent [open (openable $Obj)])
	($Obj is open)
	(The $Obj is) already open.

(prevent [open $Obj])
	($Obj is locked)
	(The $Obj is) locked.

(narrate opening $Obj)
	You open (the $Obj)
	(current player $Player)
	(if) ~($Player is nested #in $Obj) (then)
		(collect $Child)
			*($Child is #in $Obj)
			(reveal $Child)
		(into $List)
		(if) (nonempty $List) (then)
			, revealing (a $List)
			(notice $List)
		(endif)
	(endif)
	.

(perform [open $Obj])
	(narrate opening $Obj)
	(now) ($Obj is open)

