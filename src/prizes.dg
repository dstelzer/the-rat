%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% ACT 1 - THE WINE CELLAR
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#p-1-shortest %% Fallback so the first PROCEED always succeeds, no matter what
(prize *)
(* available in act 1)
(* requires 0 turns)
(* is worth 1 thousand dollars)
(name *) bottle of centuries-old vinegar
(prize conversation about *)
	(div @spider) { Why would he be storing vinegar in the wine cellar? }
	(div @jackdaw) { it was wine at one point but its definitely not any more }

#p-1-short-a
(prize *)
(* available in act 1)
(* requires 3 turns)
(* is worth 1 thousand dollars)
(name *) bottle of chateau lafite
(prize conversation about *)
	(div @spider) { I admire your restraint in not making a pun about the billionaires liking feet. }
	(div @jackdaw) { well i cant now can i (line) thanks for that }
	(div @chameleon) { You could try with "toe"? }
	(div @jackdaw) { it just wouldnt be the same now }

#p-1-short-b
(prize *)
(* available in act 1)
(* requires 3 turns)
(* is worth 1 thousand dollars)
(name *) japanese whiskey with an incomprehensible name
(prize conversation about *)
	(div @chameleon) { Are you supposed to store whiskey in a wine cellar? }
	(div @jackdaw) { absolutely not keeping them horizontal ruins them }
	(div @rat) { Is this one of worth? Not ruined? }
	(div @jackdaw) { enough people just want it as a status symbol, itll sell fine }

#p-1-med-a
(prize *)
(* available in act 1)
(* requires 5 turns)
(* is worth 2 thousand dollars)
(name *) bottle of assaratum
(prize conversation about *)
	(div @chameleon) { It's real?! }
	(div @spider) { I have never heard of that one. Is it any good? }
	(div @chameleon) { It's an old legend about fermenting human blood into alcohol, for use in cult rituals. }
	(div @jackdaw) { real apparently yes (line) good probably not }
	(div @spider) { I mostly expected this to be a pun on "ass". }
	(div @jackdaw) { i dont lie when it comes to wine }

