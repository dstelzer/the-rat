%% The whole "actions" section of stdlib.dg was excised and moved to actions_base.dg
%% Then the parts that are wanted for this game were moved over here
%% This means:
%% - TELL (Fox)
%% - WAIT (Fox)
%% - Commands (Fox)

%% - GO (Rat, Chameleon)
%% - SABOTAGE (Rat)

%% - PROCEED (Jackdaw)
%% - SCORE (Jackdaw)

%% - LOOK (Spider)
%% - EXAMINE (Spider)
%% - HACK (Spider)

%% - MINGLE (Chameleon)
%% - DISENGAGE (Chameleon)

%% - TAKE (Butler)
%% - DROP (Butler)
%% - ATTEND TO (Butler)

%% We also preserve two pieces of special syntax in stdlib.dg
%% Bare directions for GO; and ACTOR, ACTION for TELL ACTOR TO ACTION

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Commands

(interface (command $<Action))

@(understand command $Action)
	(understand $Action)
	(command $Action)

(describe action (command $Action))
	issue the (exhaust) { *($Word is one of $Action) $Word } command

%% QUIT

(command [quit])
(understand [quit/q] as [quit])
(prevent [quit])
	~(interpreter supports quit)
	(div @meta) { In this interpreter, close the window to quit the game. }
(perform [quit])
	(div @meta) { Really quit? \(y (no space) / (no space) n\) }
	(if) (yesno) (then)
		(div @meta) (display quit message)
		(quit)
	(endif)
	(stop)

(display quit message)
	Thanks for playing!

%% RESTART

(understand command [restart])
(perform [restart])
	(div @meta) {
		Restart the game from the beginning? \(
		(if) (library links enabled) (then) (link) y (else) y (endif)
		(no space) / (no space)
		(if) (library links enabled) (then) (link) n (else) n (endif)
		\)
	}
	(if) (yesno) (then)
		(restart)
		(div @meta) { Failed to restart. }
	(endif)
	(stop)

%% SAVE

(understand command [save])
(perform [save])
	(if) (save $ComingBack) (then)
		(if) ($ComingBack = 1) (then)
			(roman)
			(div @meta) { Game state restored successfully. }
			(div @roomheader) (location headline)
		(else)
			(div @meta) { Game state saved successfully. }
		(endif)
	(else)
		(div @meta) { Failed to save the game state. }
	(endif)
	(stop)

%% RESTORE

(understand command [restore])
(perform [restore])
	(restore)
	(div @meta) { Failed to restore the game state. }
	(stop)

%% UNDO

(command [undo])
(perform [undo])
	(if) ~(interpreter supports undo) (then)
		(div @meta) { This interpreter doesn't support undo. }
	(elseif) (undo) (then)
		(div @meta) { Failed to undo last turn. }
	(else)
		(div @meta) { There are no more turns to undo! }
	(endif)
	(stop)

(narrate undoing $Words)
	(div @meta) { Undoing the last turn \( (print words $Words) \). }
	(line)
	(location headline)

%% TRANSCRIPT

(command [transcript on])
(understand [transcript/script on] as [transcript on])
(understand [transcript/script] as [transcript on])

(perform [transcript on])
	(div @meta) {
		(if) (transcript on) (then)
			Transcript enabled.
		(elseif) (transcript active) (then)
			%% Do nothing, transcripting is already active
		(else)
			Failed to enable transcript.
			(stop)
		(endif)
	}

(command [transcript off])
(understand [transcript/script off] as [transcript off])

(perform [transcript off])
	(transcript off)
	(div @meta) { Transcript disabled. }

%% SCORE

%% Disabled, see below

%% NOTIFY

%% Disabled, see below

%% VERBOSE / BRIEF / SUPERBRIEF / SUPERVERBOSE

%% Disabled, see below

%% VERSION

(understand command [version])
(understand [banner] as [version])
(perform [version])
	(banner)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Fox

%% TELL <obj> TO | <action>

(understand [tell/ask | $Words] as [tell $Actor to | $Action])
	*(split $Words by [, to] into $Left and $Right)
	*(understand $Left as single object $Actor preferably animate)
	(current actor $OldActor)
	(now) (current actor $Actor)
	(rewrite $Right into $Simplified)
	(collect $A)
		*(understand $Simplified as $A)
	(into $List)
	(now) (current actor $OldActor)
	*($Action is one of $List)

(understand [ask | $Words] as [tell $Actor to give $Obj to $Player])
	*(split $Words by [for] into $Left and $Right)
	*(understand $Left as single object $Actor preferably animate)
	*(understand $Right as object $Obj preferably child of $Actor)
	(current player $Player)

%% The rule for "name comma action" is further down in the file.

(unlikely [tell $Addressee to | $])
	~(animate $Addressee)

(describe action [tell $Actor to give $Obj to (current player $)])
	ask (the full $Actor) for (the full $Obj)

(describe action [tell $Actor to tell (current player $) about $Topic])
	ask (the full $Actor) about (describe topic $Topic)

(describe action [tell $Actor to | $Action])
	tell (the full $Actor) to (describe action $Action)

(unlikely [tell $Obj to | $])
	~(animate $Obj)

(action [tell $NPC to | $] requires $NPC to be present) (just)
~(action [tell $ to | $] requires $ to be touched)

(instead of [tell $NPC to greet])
	(try [greet $NPC])

(instead of [tell $NPC to tell (current player $) about $Topic])
	(try [ask $NPC about $Topic])

(perform [tell $Actor to | $])
	(div @spider) It does not seem that (the $Actor) will take orders from us.

(action [tell $ to | $] is valid for *(protagonist $))

%% WAIT

(grammar [wait/z] for [wait])

(perform [wait])
	(select)
		(div @chameleon) { So, darling, what comes next? }
	(or)
		(div @jackdaw) { dot dot dot }
	(or)
		(div @spider) { All systems ready. }
	(or)
		(div @rat) { The rat waits. }
	(at random)

(action [wait] is valid for *(protagonist $)) %% All characters can do it

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Rat

%% Navigation by direction:

%% What the player types is eventually translated into one of:

%% [leave $Room $Dir]
%% [leave $Room $Dir by $Vehicle]
%% [leave $Room $Dir with $Obj]

%% These are generally the ones to override/extend.

%% The default rules for the aforementioned actions invoke '(prevent entering
%% $Room)' and '(narrate entering $Room)'. These predicates can of course also
%% be overridden. Thus, entering a room is not an action of its own, but is
%% an inherent part of leaving a room.

%% GO <direction>

%% The rule for just typing a list of directions (without a verb) is in stdlib.dg

(grammar [go/walk/crawl/leave/get/climb [direction]] for [go $])
(grammar [go/walk/crawl [to further] [direction]] for [go $])
(grammar [go/walk/crawl] for [go #out])
(grammar [enter] for [go #in])

(understand [climb] as [go $Dir])
	(current room $Room)
	*($Dir is one of [#up #down])
	(from $Room go $Dir to $)

(unlikely-complex [go $DirList] 0)
	(just)
	(if) (direction $DirList) (then)
		($Dir = $DirList)
	(else)
		%% Only consider the first direction in the list.
		([+ $Dir | $] = $DirList)
	(endif)
	(unlikely [go $Dir])

(unlikely [go $Dir])
	(current room $Room)
	~{
		(from $Room go $Dir to $Target)
		{ (room $Target) (or) (door $Target) (or) (direction $Target) }
	}

(perform [go $Dir])
	(current player $Actor)
	(current room $Room)
	(if) ($Actor has parent $Room) (then)
		(try [leave $Room $Dir])
	(else)
		($Actor has parent $Vehicle)
		(try [leave $Room $Dir by $Vehicle])
	(endif)

%% LEAVE <room> <dir>
%% LEAVE <room> <dir> BY <vehicle>
%% LEAVE <room> <dir> WITH <object>

(instead of [leave $Room $Dir])
	(from $Room go $Dir to $Target)
	(direction $Target)
	(try [leave $Room $Target])

(prevent [leave $Room $Dir])
	(if) (from $Room go $Dir to $Target) (then)
		(if) (door $Target) (then)
			{
				(when $Target blocks passage)
			(or)
				(from $Room through $Target to $OtherRoom)
				(prevent entering $OtherRoom)
			}
		(elseif) (room $Target) (then)
			(prevent entering $Target)
		(else)
			(narrate failing to leave $Room $Dir)
		(endif)
	(else)
		(if) ($Dir is one of [#out #in]) (then)
			(if) (current player #rat) (then)
				(div @rat) { The rat will go. But which way? }
			(else)
				(div @chameleon) { Yes, but which way exactly? }
			(endif)
			(asking for direction in [go []])
		(else)
			(narrate failing to leave $Room $Dir)
		(endif)
	(endif)

(narrate leaving $Room $Dir)
	(current player #rat)
	(div @rat) {
		(select)
			The rat
		(or)
			It
		(or)
			The rat, it
		(then purely at random)
		(select)
			moves
		(or)
			goes
		(or)
			is moving
		(or)
			is going
		(purely at random)
		.
	}

(narrate leaving $Room $Dir)
	(div @chameleon) {
		TODO!
	}

(perform [leave $Room $Dir])
	(narrate leaving $Room $Dir)
	(from $Room go $Dir to room $Target)
	(enter $Target)

(action [go/leave | $] is valid for #rat/#chameleon)

%% SABOTAGE <obj>

(grammar [sabotage/break/wreck [single]] for [sabotage $])

(prevent [sabotage ~(sabotage target $Obj)])
	(div @rat) { The rat assesses. But (the $Obj) , (it $Obj) offer(s $Obj) nothing. No means of destruction. }

(perform [sabotage $Obj])
	(narrate sabotaging $Obj)
	(now) ($Obj is broken)

(narrate sabotaging $Obj) %% Fallback
	(div @rat) { (The $Obj) , it yields. It opens. It breaks. }

(action [sabotage $] is valid for #rat)

(after [examine (sabotage target $Target)])
	(if) ($Target is broken) (then)
		(div @rat) { Damaged. In need of repair. }
	(else)
		(div @rat) { Vulnerable. (It $Target) could be opened. Changed. }
	(endif)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Jackdaw

(grammar [proceed] for itself)

(prevent [proceed])
	(current act 0)
	(#butler is in room #garden1)
	(div @jackdaw) { like i said (line) get the butler out of the way first }

(perform [proceed])
	(current act 0)
	(div @jackdaw) { on it }
	(div @spider) { She is in! }
	(div @jackdaw) { down in the basement ready to rob this place blind }
	(now) (jackdaw has entered)

(perform [proceed])
	TODO Proceed!

(action [proceed] is valid for #jackdaw)

(grammar [score] for itself)

(perform [score])
	TODO Score!

(action [score] is valid for #jackdaw)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Spider

%% LOOK

(default action $Obj [examine $Obj])
(narrate entering $Room) (try [examine $Room])

(describe room $Room)
	(select)
		Looking at Rat's location...
	(or)
	(stopping)
	(div @roomheader) (location headline)
	(current scope ceiling $Ceil)
	(look $Ceil)
	(make appearances #in $Room)
	(par)

(understand [examine/x/watch/describe/check/look/l/view | $Words] as [examine $Room])
	(understand $Words as room name $Room)
(understand [look/l at | $Words] as [examine $Room])
	(understand $Words as room name $Room)

(understand $Words as room name $Room)
	(filter $Words into $Filtered)
	(nonempty $Filtered)
	(determine object $Room)
		*(room $Room)
		%% Don't require visited
	(from words)
		*(dict $Room)
	(matching all of $Filtered)

(prevent [examine (room $Room)])
	~(in bounds for this act $Room)
	(if) ($Room is visited) (then)
		(div @spider) { Not relevant at the moment. }
	(else)
		(div @spider) { For the moment, I am afraid I have no eyes there. }
	(endif)

(perform [examine (room $Room)])
	(div @spider) (describe room $Room)

(add $Room to scope)
	*(in bounds for this act $Room)

%% EXAMINE <obj>

(default actions enabled)
(default action $Obj [examine $Obj])

(grammar [examine/x/watch/describe/check/look/l/view [object]] for [examine $])
(grammar [look/l at [object]] for [examine $])

~(action [examine $] requires $ to be touched)

(perform [examine ~(room $Obj)])
	(div @spider) {
		(descr $Obj)
		(if) (supporter $Obj) (then)
			(exhaust) {
				*($Child is #on $Obj)
				(par)
				(appearance $Child #on $Obj)
				(notice $Child)
			}
		(endif)
		(if) (container $Obj) ~{ (opaque $Obj) ($Obj is closed) } (then)
			(exhaust) {
				*($Child is #in $Obj)
				(par)
				(appearance $Child #in $Obj)
				(notice $Child)
			}
		(endif)
		(par)
	}

(action [examine $] is valid for #rat/#chameleon/#spider)

(add $Obj to scope)
	*(in bounds for this act $Room)
	*($Obj has ancestor $Room)

%% HACK <obj>

(grammar [hack [single]] for [hack $])

(prevent [hack ~(hack target $Obj)])
	TODO not a target.

%% No default PERFORM rule

(action [hack $] is valid for #spider)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Chameleon

%% MINGLE

(grammar [mingle/socialize] for [mingle])

(prevent [mingle])
	(people are following)
	TODO people are already following!

(prevent [mingle])
	(#chameleon is in room $Room)
	~(#crowd is in room $Room)
	TODO People not there!

(perform [mingle])
	TODO it works!
	(now) (people are following)

@(people are not following) ~(people are following)

(action [mingle] is valid for #chameleon)

%% DISENGAGE

(grammar [disengage/separate] for [disengage])

(prevent [disengage])
	(people are not following)
	TODO people are already not following!

(perform [disengage])
	TODO it works!
	(now) (people are not following)

(action [disengage] is valid for #chameleon)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Butler

(narrate fixing $Obj) %% Fallback
	(div @spider) { The butler is working on repairing (the $Obj) . }
