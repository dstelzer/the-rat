%% This file is misleadingly named, but I couldn’t think of a better name for it
%% It holds the data for all the protagonists and the act transitions
%% For the layout of the map, see topology.dg
%% For the actions referenced here, see actions.dg
%% For the butler’s AI, see ai.dg

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Protagonists
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(animate *(protagonist $))
(add *(protagonist $) to scope)

#fox %% Solely for the sake of EXAMINE
(protagonist *)
(name *) Fox
(perform [examine *])
	(div @jackdaw) { that’s you }
	(div @spider) { Our logistical planner and coordinator. }
	(div @chameleon) { Our daring, dashing leader. }
	(div @rat) { Gives the commands. }

#rat
(protagonist *)
(name *) Rat
(letter for *) R
%% neuter
(current player *)
(* is #in #garden2)
(have * refuse $)
	(div @rat) { The rat cannot. It is not able. }

(perform [examine *])
	(div @rat) { The rat is the instigator. The saboteur. It sneaks. It destroys. }

(occupied $Room)
	*(enemy $Enemy)
	($Enemy is in room $Room)

(late on every tick)
	(* is in room $Room)
	(if) (occupied $Room) ~(rat is hiding) (then)
		(div @rat) {
			People approach! The rat must hide!
		}
		(now) (rat is hiding)
	(elseif) ~(occupied $Room) (rat is hiding) (then)
		(div @rat) {
			The rat is alone, and free to act.
		}
		(now) ~(rat is hiding)
	(endif)

(prevent [leave/sabotage | $])
	(current player *)
	(rat is hiding)
	(div @rat) {
		The rat cannot! It hides; it would be seen!
	}

(prevent entering $Room)
	(occupied $Room)
	(current player *)
	(div @rat) {
		No! Impossible! The rat would be seen.
	}

(rat-link direction $Dir)
	(collect words)
		(if) ~(current player #rat) (then)
			Rat ,
		(endif)
		(name $Dir)
	(into $Link)
	(vlink $Link {(name $Dir)})

(status bar line)
	(div @statusline) {
		(span @ratcolor) {
			(span @bold) { Rat } :
			(#rat is in room $Room)
			(collect $Dir)
				*(direction $Dir)
				(from $Room go $Dir to $Next)
				(in bounds for this act $Next)
			(into $List)
			(listing $List {(rat-link direction $_)} @, @the 0)
			(if) *($Obj has ancestor $Room) (sabotage target $Obj) (then)
				;
				(collect words)
					(if) ~(current player #rat) (then)
						Rat ,
					(endif)
					sabotage (the $Obj)
				(into $Link)
				(vlink $Link {sabotage (the $Obj)})
			(endif)
		}
	}

#spider
(protagonist *)
(name *) Spider
(male *)
(letter for *) S
(have * refuse $)
	(div @spider) { That is not something I can do myself. }

(perform [examine *])
	(div @spider) { I handle communications and watch the cameras. }

(status bar line)
	(div @statusline) {
		(span @spidercolor) {
			(span @bold) { Spider } :
			({wait})
			(if) (long wait unlocked) (then)
				, ({long wait})
			(endif)
			; view any room or object
			(if) (hack target $Obj) (then)
				;
				(collect words)
					(if) ~(current player #spider) (then)
						Spider ,
					(endif)
					hack (the $Obj)
				(into $Link)
				(vlink $Link {hack (the $Obj)})
			(endif)
		}
	}

#jackdaw
(protagonist *)
(name *) Jackdaw
(female *)
(letter for *) J
(have * refuse [go | $])
	(div @jackdaw) { when you want me to go you have to say proceed (line) because spider wouldn’t let me use go }
(have * refuse $)
	(div @jackdaw) { i dont need micromanaging i just need you to tell me when to start and leave the rest to me }

(perform [examine *])
	(div @jackdaw) { i’m the thief i steal stuff }

(status bar line)
	(div @statusline) {
		(span @jackdawcolor) {
			(span @bold) { Jackdaw } :
			(collect words)
				(if) ~(current player #jackdaw) (then)
					Jackdaw ,
				(endif)
				proceed
			(into $Link)
			(vlink $Link {proceed})
			;
			(collect words)
				(if) ~(current player #jackdaw) (then)
					Jackdaw ,
				(endif)
				score
			(into $Link2)
			(vlink $Link2 {score})
		}
	}

#chameleon
(protagonist *)
(name *) Chameleon
(female *)
(letter for *) C
(have * refuse $)
	(div @chameleon) { I’m sure I’d love to, but I think someone else might be better-suited for that. }

(perform [examine *])
	(div @chameleon) { I’m the face of the operation. The distraction. Your favorite femme fatale. }

(cham-link direction $Dir)
	(collect words)
		(if) ~(current player #chameleon) (then)
			Chameleon ,
		(endif)
		(name $Dir)
	(into $Link)
	(vlink $Link {(name $Dir)})

(status bar line)
	(current act 3) %% not available before 3, not available in 4
	(div @statusline) {
		(span @chameleoncolor) {
			(span @bold) { Chameleon } :
			(#chameleon is in room $Room)
			(collect $Dir)
				*(direction $Dir)
				(from $Room go $Dir to $Next)
				(in bounds for this act $Next)
			(into $List)
			(listing $List {(cham-link direction $_)} @, @the 0)
			;
			(collect words)
				(if) ~(current player *) (then) Chameleon , (endif)
				(if) (people are following) (then) disengage (else) mingle (endif)
			(into $Words)
			(if) (people are following) (then)
				(vlink $Words {disengage})
			(else)
				(vlink $Words {mingle})
			(endif)
		}
	}

#butler
(enemy *) %% Rat always has to hide, even when suborned
(protagonist *) (butler has the earpiece)
(name *) butler
(animate *)
(male *)
(letter for *) B
(* is #in #garden1)
(have * refuse $)
	(div @spider) { The butler shakes his head, ever so slightly. }
(appearance *)
	(current player *)
(appearance *)
	(current goal $)
	({The butler}) is moving with purpose toward his next task.
(appearance *)
	({The butler}) is hard at work
	(if) (current act $Act) ($Act < 2) (then)
		making ready for the party.
	(else)
		attending to the guests.
	(endif)
(descr *)
	(current goal $Goal)
	He’s hurrying toward (the $Goal).
(descr *)
	A house like this would normally have half a dozen staff at least, and now all these tasks fall to him. It’s no wonder he never has a chance to rest.

(butler-link direction $Dir)
	(collect words)
		(if) ~(current player #butler) (then)
			Butler ,
		(endif)
		(name $Dir)
	(into $Link)
	(vlink $Link {(name $Dir)})

(status bar line)
	(butler has the earpiece)
	(div @statusline) {
		(span @butlercolor) {
			(span @bold) { Butler } :
			(#butler is in room $Room)
			(collect $Dir)
				*(direction $Dir)
				(from $Room go $Dir to $Next)
				(in bounds for this act $Next)
			(into $List)
			(listing $List {(butler-link direction $_)} @, @the 0)
			(exhaust) {
				*($Obj has ancestor $Room)
				(attend target $Obj)
				; ({attend to (the $Obj)})
			}
		}
	}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Antagonists
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#crowd
(name *) various guests
(animate *)
(enemy *)
(plural *)
(appearance *) The ({guests}) are milling around and talking amongst themselves.
(descr *)
	(if) (#vespertilion is #partof *) (then) %% Disappears for part of act 4
		({Count Vespertilion}), the host;
	(endif)
	({Luna L Meresankh}), the Silicon Valley star;
	({Constantine Quinn}), the refrigerator magnate;
	({Dr Malatesta}), the famous biologist;
	and ({Ari Tension}), the media mogul.
(letter for *) V

#crowd2
(name *) other guests
(animate *)
(enemy *)
(appearance *) (appearance #crowd) %% They’re effectively a single object in two rooms
(descr *) (descr #crowd)
(letter for *) L
(unlikely $Action) (* is one of $Action)

#vespertilion
(name *) Count Vespertilion
(proper *)
(male *)
(descr *) A small and angular man with wispy silver hair and an immaculate suit.
(letter for *) V
(* is #partof #crowd)

#llm
(name *) Luna L Meresankh
(proper *)
(female *)
(descr *) A tall and angular woman with a pointy face and dramatic hair.
(* is #partof #crowd)

#constantine
(name *) Constantine Quinn
(proper *)
(male *)
(descr *) A rotund man in his 50s with a booming voice and a hearty laugh.
(* is #partof #crowd)

#malatesta
(name *) Dr Malatesta
(proper *)
(male *)
(descr *) A small man with a round face and thick glasses that hide his eyes.
(* is #partof #crowd)

#tension
(name *) Ari Tension
(proper *)
(male *)
(descr *) A muscular man with a shrill voice and thick, angry eyebrows.
(* is #partof #crowd)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Act Transitions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(intro)
	(introductory cutscene)
	(update environment around player)
	(try [examine #garden2])

(get an initial comment)
	*(repeat forever)
	(save undo $)
	({Yes}) / ({No}) / ([] {\[ nothing \]}) >>
	(get input $Words)
	(if) (empty $Words) (then)
		(select)
			(div @spider) { Fox? Are you there? }
		(or)
			(div @spider) { Testing? Do you see anything? }
		(or)
			(div @jackdaw) { this job is off to a great start good job everyone }
		(or)
			(div @chameleon) { Still nothing. Such a shame, I was just about to start telling you all about the Bryce Wyatt affair... }
		(or)
			(div @chameleon) { Please, dear, say something. Anything? }
		(or)
			(div @rat) { The cables are traced. Connections good. }
		(or)
			(div @spider) { Well, there is no real point continuing on without working communications. All right, team. Pack it up. }
			(game over { Your heist has failed })
		(stopping)
		(fail)
	(endif) %% Otherwise succeed

(introductory cutscene)
	(div @spider) { Testing. Lorem ipsum dolor sit amet. Are all of you seeing this? }
	(div @rat) { Yes. Seeing. }
	(div @jackdaw) { yeah }
	(div @chameleon) { Perfectly! }
	
	(get an initial comment)
	
	(div @spider) { I will take that as a yes. Are we in position? Rat? }
	(div @rat) { The rat is prepared. The cameras are placed. In the garden it hides. }
	(div @spider) { Jackdaw? }
	(div @jackdaw) { yeah }
	(div @spider) { Chameleon? }
	(div @chameleon) { I have never been more ready. Sincerely, even though I’m about to do nothing for an hour and a half waiting for the gala to start. }
	(div @spider) { Fox? }
	
	(get an initial comment)
	
	(div @jackdaw) { and what about you spider (line) position and all that? }
	(div @spider) { Well, yes. For completeness, I am in the control room two blocks away. All systems are running smoothly. I have eyes on the outer garden. Ninety minutes until the largest gathering of New Gothenburg’s patrician class that I have ever seen. }
	(div @chameleon) { Ninety minutes until we pull off the heist of the century. }
	(div @jackdaw) { lets (space) ----ing go }
	
	(pause)
	(div @header) { Prologue: Getting In }
	
	(div @spider) { Fox, you should be seeing a map of the south gardens. Rat is at the R, Jackdaw is... }
	(div @jackdaw) { close enough to the door (line) thats all that matters }
	(div @spider) { Fine. And the butler is at the B. Text communication is running; we are at your command. }
	(div @rat) { The rat is prepared to obey every word. Tell it to go. Tell it to sabotage. }
	(div @spider) { By which it means compass directions, so that we do not waste time with “your right or my right”. And for Jackdaw... }
	(div @jackdaw) { just get the butler away from the door and say “proceed” thats all you have to do }
	(div @spider) {
		You should be seeing a bar of suggestions at the bottom of your screen.
		(if) (interpreter supports links) (then)
			Click or type
		(else)
			Type
		(endif)
		one of those commands and we will obey.
	}
	(div @chameleon) { Allez! }

(on every tick) %% Some nudges
	(current act 0)
	~(jackdaw has entered)
	(select)
	(or)
	(or)
	(or)
	(or)
		(div @jackdaw) { i’m ready to go when you are (line) just get the butler out of the way and say proceed }
	(cycling)

(on every tick)
	(current act 0)
	(jackdaw has entered)
	(select)
	(or)
	(or)
	(or)
		(div @jackdaw) { i’m down here and ready }
		(div @spider) { As soon as we get Rat into the building, it will start making distractions for you. }
		(div @rat) { Yes. I must enter. }
	(or)
	(cycling)

(start act one)
	(div @rat) { The rat moves. The way is clear. The mansion is open. }
	(div @spider) { Or in other words... }
	(div @chameleon) { (span @italic) { We’re in. } }
	(select quip #q-actchange)
	
	(banner)
	(pause)
	(div @header) { Act One: Getting Oriented }
	
	(div @jackdaw) { im in the wine cellar and theres bottles here worth more than a house (line) and also security worth more than a house }
	(div @spider) { That should not be a problem. With only a single butler around, all Rat has to do is keep him occupied. }
	(div @rat) { Yes. The rat can. The rat will. }
	(div @spider) { Once the butler is distracted, Fox will tell you when to (span @bold) proceed . }
	(div @chameleon) { Simple and elegant. I like it. }
	(div @jackdaw) { as per my last email (line) lets (space)----ing go }
	
	(now) (current act 1)
	(move #rat to #dine2)
	(move #butler to #dine1)
	(try [examine #dine2])

(understand command [act1])
(perform [act1])
	(start act one)

(start act two) %% triggered in prizes.dg
	(div @spider) { All right. I will begin. Chameleon, please watch the cameras while I work. }
	(div @chameleon) { Ten-four. Watching. }
	(div @jackdaw) { and i’m going to stand here holding a router (line) yay }
	(div @rat) { . (space) . (space) . (space) . (space) . (space) . (space) . }
	
	(exhaust the current quip before changing acts)
	
	(pause)
	(div @header) { Act Two: Getting Rich }
	
	(div @spider) { It is done. I am opening the next rooms now. Chameleon, what have you seen? }
	(div @jackdaw) { guests’ belongings here i come }
	(div @chameleon) { The butler is running around a lot. He took the crank off the chandelier and locked down the piano so we can’t mess with those any more. The guests showed up, he welcomed them in, served numerous drinks, and now they’re eating and talking in the dining area. Any word on getting me that invitation? }
	(div @spider) { I am working on it. Once Jackdaw can get access to the IoT network, it will happen. }
	(div @jackdaw) { well you can take your time there’s tons of stuff to raid here }
	
	(now) (current act 2)
	(move #crowd to #dine1)
	(move #crowd2 to #dine2)
	(move #butler to #dine1)
	(if) (#rat is in room $Room) ($Room is one of [#dine1 #dine2]) (then)
		(move #rat to #glasgild)
		(try [examine #glasgild])
	(endif)

(understand command [act2])
(perform [act2])
	(start act two)

(start act three) %% triggered in prizes.dg
	(div @spider) { I will begin. As before, Chameleon, please keep your eye on the cameras. }
	(div @chameleon) { Not that there’s much else for me to do. }
	(div @jackdaw) { well that’s about to change if we can get you this invite }
	(div @rat) { . (space) . (space) . (space) . (space) . (space) . (space) . }
	
	(exhaust the current quip before changing acts)
	
	(pause)
	(div @header) { Act Three: Getting Out }
	
	(div @spider) { You are officially on the guest list. You have the card, yes? }
	(div @chameleon) { Right here in my hand. I’m walking up to the door now. }
	(div @spider) { Jackdaw, can you access the vault? }
	(div @jackdaw) { it’s open and ready to be robbed }
	(div @spider) { Rat? }
	(div @rat) { The rat waits. The rat has waited. Continue. }
	(div @spider) { And I am tracking both Rat and Chameleon on the cameras now. Fox, we are ready to go as soon as you say the word. }
	
	(now) (current act 3)
	(move #chameleon to #dine1)
	(move #crowd to #dine1)
	(now) (#crowd2 is nowhere)
	(try [examine #dine1])
	
	%% Add one syntax hint, since players were confused
	(div @spider) { Now that there are multiple people moving around, you can use their names to avoid ambiguity—RAT, EAST or CHAMELEON, NORTH or such. If you do not specify, we will assume you mean the same person as in your previous instruction. }

(understand command [act3])
(perform [act3])
	(start act three)

(start act four) %% triggered in prizes.dg
	(div @spider) { I am beginning my work now. }
	(div @chameleon) { I’m afraid I can’t watch the feeds for you this time. I have my hands full in here. }
	(div @spider) { That should be fine. Everything is thoroughly under control now. }
	(div @rat) { . (space) . (space) . (space) . (space) . (space) . (space) . }
	
	(exhaust the current quip before changing acts)
	
	(pause)
	
	(div @rat) { Mayday! Alert! Does Spider see? }
	(div @rat) { Is Spider there? Can he hear? Read? }
	(div @rat) { The rat tries to watch. Chameleon speaks to Luna. Luna gestures. Chameleon winces, flinches, puts a hand on the earpiece. Removes it, hides it on the table. }
	(div @rat) { Chameleon is in, she is talking, but she cannot talk to us. }
	(div @rat) { Spider? Jackdaw? Fox? }
	
	(pause)
	(div @header) { Epilogue: Getting Even }
	
	(div @spider) { I have access to all the cameras now, covering every room on the ground floor, and—what is going on‽ Why has Chameleon disconnected? }
	(div @jackdaw) { don’t ask me i’ve been clinging halfway up a wall holding a camera for you }
	(div @rat) { The rat has watched. Read the log. }
	(div @spider) { Oh no. Oh no no no. I tell you to watch the cameras for fifteen minutes and this happens‽ You couldn’t even handle that‽ }
	(div @jackdaw) { and what exactly did you want rat to do (line) jump out of hiding and tell chameleon to put the piece back in (line) it said it here in the chat that should’ve been enough }
	(div @spider) { I am going to pull up all the feeds. Jackdaw, keep an eye on everything. }
	(div @jackdaw) { on it }
	
	(now) (current act 4)
	(move #chameleon to #dine1)
	(move #crowd to #dine1)
	(move #rat to #dine2)
	(move #butler to #gran2)
	(move #vespertilion to #gran2)
	(if) ($Obj is #heldby #butler) (then) (now) ($Obj is #in #dine2) (endif)
	(now) (#tray is #heldby #butler)

(understand command [act4])
(perform [act4])
	(start act four)

(on every tick)
	(current act 4)
	~(butler has the earpiece)
	(select)
		(div @spider) { No biometrics are coming through from Chameleon’s earpiece. But I have audio. }
		(div @guests) {
			Vespertilion: The evening could be considered a marginal success, despite your frankly unacceptable performance. The service was slow. You were constantly distracted, leaving no one to attend to the guests. When people needed drinks, you were nowhere to be found. (par)
			Vespertilion: And the security was no better than the service! People have entered the lower floors and made off with who even knows what.
		}
	(or)
		(div @guests) {
			Vespertilion: Insurance will pay more than the losses and the objects will be easily tracked; the thieves will not get far. But the loss of face will be atrocious should this reach the press. (par)
			Vespertilion: Needless to say, I will expect you to trace and retrieve my property with all haste. Finish the cleanup from the dinner, attend to the guests’ needs, see them out, then begin work on the theft. And expect a seven percent pay cut for this fiasco. I consider that more than generous, given the mess you caused.
		}
		(div @spider) { Vespertilion is turning away and moving back toward the dining room. }
		(now) (#vespertilion is #partof #crowd)
	(or)
		(div @spider) { I am seeing biometric data on Chameleon’s earpiece again. Someone is wearing it. }
		(now) (butler has the earpiece)
	(stopping)

(understand command [act5])
(perform [act5])
	(finishing cutscene)

(finishing cutscene)
	%% This starts right after Spider describes the butler uploading the data
	(div @guests) {
		\* (no space) static (no space) \* (par)
		Vespertilion \( recorded \): (space) ...wo of us must put in millions up front, but this plan should pay off in the tens or hundreds of billions. (par)
		Luna \( recorded \): What you’re suggesting is a classic maneuver, generally known as a “Ponzi scheme” after Italian con artist Francesco Ponzi. While often conflated with pyramid schemes, Ponzi schemes differ in several ways. For example, in Ponzi schemes, the con artist acts as a central hub, and the source of the investment returns is hidden from the participants. (par)
		Vespertilion \( recorded \): I would not use such terms out loud where they might be recorded. (par)
		Luna \( recorded \): Don’t worry—all conversations are recorded for training purposes, but they are securely encrypted and cannot possibly be breached or retrieved. (par)
		Vespertilion \( recorded \): Regardless. Your reputation and your businesses provide an ideal front for this, an apparent source of profit. My title provides legitimacy to attract investors. The Gilded Wing has tragically reduced the Vespertilion treasury. This plan stands to enrich us both considerably. (par)
		Luna \( recorded \): I’m in.
	}
	(div @spider) { Then silence. Everyone is staring at the hosts. }
	(div @guests) {
		Tension: PYRAMIDAI OR PYRAMID SCHEME? Scandalous revelations rock new tech startup!
	}
	(div @spider) { He is grabbing a pager from his belt. }
	(div @guests) {
		Tension: Stop the presses! New story takes the front page!
	}
	(div @spider) { I am trying to continue transcribing, but everyone is shouting over each other. }
	(div @rat) { It looks like Chameleon, she is slipping away. }
	(div @jackdaw) { and not just chameleon (line) i’m on my way out (line) let’s go }
	(pause)
	(div @spider) { The earpiece is moving too. }
	(div @rat) { Perhaps the crew waits. A moment. For a new member to join. }
	
	(accumulate $K)
		*(prize $Prize)
		($Prize is handled)
		($Prize is worth $K thousand dollars)
	(into $Total)
	
	(div @jackdaw) {
		a six way split of ($Total thousand dollars) doesn’t sound so bad (line)
		($Total thousand dollars divided by six with remainder $Mod) each instead of ($Total thousand dollars divided by five) (line)
		(if) ($Mod = 2) (then)
			i’ll even cover the extra two cents (line)
		(endif)
	}
	
	(if) *(personal treasure $T) ($T is handled) (then)
		(div @rat) { Not only that. Also more. }
		(exhaust) {
			*(personal treasure $Tres)
			($Tres is handled)
			(ending paragraph for $Tres)
		}
	(else) %% Need an intervening paragraph so it’s not two Jackdaw lines together (though we can’t always prevent it in the former case)
		(div @rat) { Money. Success. Nothing more, maybe sad. But money is much. }
	(endif)
	
	(the end)

(the end)
	(div @jackdaw) { actually wait wait wait spider }
	(div @spider) { Yes? }
	(div @jackdaw) { take the extra couple minutes to short every stock connected to vespertilion or llm }
	(div @spider) { Brilliant. I am on it. }
	(div @jackdaw) { maybe we walk out of this richer than ever (line) i think this is where chameleon would say }
	(game over {Finis})
