%% Z-machine styling

(style class @body)
	background-color: black;
	color: white;

(startup) (body style @body)

(platform) Z-machine

(style class @rat)
	color: yellow;
	margin-top: 1em;
	margin-bottom: 1em;
(style class @ratcolor)
	color: yellow;

(style class @spider)
	color: cyan;
	margin-top: 1em;
	margin-bottom: 1em;
(style class @spidercolor)
	color: cyan;

(style class @jackdaw)
	color: green;
	margin-top: 1em;
	margin-bottom: 1em;
(style class @jackdawcolor)
	color: green;

(style class @chameleon)
	color: magenta;
	margin-top: 1em;
	margin-bottom: 1em;
(style class @chameleoncolor)
	color: magenta;

(style class @guests)
	color: inherit;
	margin-top: 1em;
	margin-bottom: 1em;
(style class @butlercolor)
	color: inherit;
(conversation style description) plain white (line) itll stand out

(hr)
	(progress bar 1 of 1)

(using fixed background color)
