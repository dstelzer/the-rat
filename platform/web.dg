%% Web styling

(style class @body)
	--font-status: Geneva, sans-serif;
	--font-body: Geneva, sans-serif;
(startup)
	(body style @body)

(style class @rat)
	border-top: 1px solid goldenrod;
	border-left: 1px solid goldenrod;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @ratcolor)
	color: goldenrod;

(style class @spider)
	border-top: 1px solid cyan;
	border-left: 1px solid cyan;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @spidercolor)
	color: cyan;

(style class @jackdaw)
	border-top: 1px solid green;
	border-left: 1px solid green;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @jackdawcolor)
	color: green;

(style class @chameleon)
	border-top: 1px solid magenta;
	border-left: 1px solid magenta;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
	padding: 0.25em;
(style class @chameleoncolor)
	color: magenta;

(style class @guests)
	border-top: 1px dashed \#888888;
	border-left: 1px dashed \#888888;
	border-radius: 0.75em;
	margin-top: 0.67em;
	margin-bottom: 0.67em;
(style class @butlercolor)
	color: inherit;
(conversation style description) dotted gray (line) all the colors are taken it's time for patterns

(style class @mainstatus)
	height: auto;
	font-size: 1.2em;
	line-height: 1em;
	margin-top: 0.33em;
	margin-bottom: 0.33em;
	position: relative;
