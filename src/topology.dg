%% dining room
%% sabotage: lower chandelier

#garden1
(room *)
(from * go #north to #dine1)
(from * go #east to #garden2)
(origin *) %% Might as well set our coordinate system's origin here
(* is available in act 0)
(default butler room for act 0 is *)

(name *) terrace
(look *) The dining room to the north opens seamlessly out into a wide flagstoned terrace, sloping down to the garden path to the east.

(prevent [leave * #north])
	(current act 0)
	~(jackdaw has entered)
	(div @jackdaw) { hey still waiting on that signal (line) rat needs to get me inside first }

(perform [leave * #north])
	(current act 0)
	(start act one)

#garden2
(room *)
(from * go #west to #garden1)
(from * go #east to #garden3)
(* is available in act 0)

%% south walk
(name *) south walk
(look *) The path meanders back and forth between tall ({hedges}), making sure there's no line of sight between the terrace to the west and the garden proper to the east.

#hedges
(name *) hedges
(dict *) hedge
(plural *)
(descr *) Deliberately too tall to see past. If you can never see the edges, then the garden will seem even larger than it really is.
(* is #in #garden2)

#garden3
(room *)
(from * go #west to #garden2)
(* is available in act 0)

(name *) south garden
(look *) The hedge walls open up here but still wall it in on all sides. Heaven forfend anyone see the landscaping or the ({water feature}) without an invitation.
%% sabotage: water feature

#fountain
(name *) water feature
(dict *) fountain
(* is #in #garden3)
(sabotage target *)
(descr *)
	It's shaped like a tiny mountain in the middle of the garden, with water cascading down on all sides.
	(if) (* is broken) (then)
		And also currently spraying a dozen feet in the air.
	(endif)
