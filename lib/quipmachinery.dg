%% The machinery for selecting and presenting quips

%% Whichever quip we’re currently presenting is stored here
(global variable (current quip $))
%% And how far we’ve advanced through it, for multi-part quips
(global variable (current quip position $))

%% For the selection process, we need some utilities
(repeat $N times)
	($N > 0)
	{
		%% Succeed once
	(or)
		($N minus 1 into $Nm1)
		*(repeat $Nm1 times)
	}

%% A quip is an object that provides a few specific predicates

%% (quip $) marks it as a quip
(interface (quip $>Quip))

%% (locked $) puts conditions on when it can show
(interface (locked $<Quip))

%% ($ depends on $) is a shorthand for the above: a quip is locked if any of its prereqs are not visited
(locked $Quip)
	*($Quip depends on $Prereq)
	($Prereq is unvisited)

%% ($ has priority $) returns a number showing how important it is; default 1
(interface ($<Quip has priority $>Priority))
((quip $) has priority 1)

%% ($ line $N) prints line number $N from it, starting at 1; failure means the end of the quip
(interface ($<Quip line $<Number))
%% With syntactic sugar for one-line quips
@($Quip line) ($Quip line 1)

%% The dynamic flag ($ is visited) means that a quip is exhausted, but that’s implemented in the standard library

%% Finally, ($ involves $) optionally lets quips chain into each other by prioritizing ones that “involve” the same people or objects
(interface ($<Quip involves $>Topic))

%% We can use this to select a new quip at (weighted) random
(select a new quip at random)
	(delay selection by one tick)
	(now) ~(delay selection by one tick)
(select a new quip at random)
	*(force $Quip) %% If something is forced, do it right away
	~(locked $Quip)
	~($Quip is visited)
	(select quip $Quip)
(select a new quip at random)
	(collect $Quip)
		*(quip $Quip)
		~(locked $Quip)
		~($Quip is visited)
		($Quip has priority $Priority)
		(if) ($Quip is discourse-relevant) (then) %% Currently the (if) means this only searches for *one* matching topic; this could be changed to reward *every* matching topic, so two matches > one match
			($Priority plus 2 into $NewPriority)
			*(repeat $NewPriority times)
		(else)
			*(repeat $Priority times)
		(endif)
	(into $Deck)
	(log) { Quip deck: $Deck }
	(if) (empty $Deck) (then)
		(select)
			(div @meta) {
				(span @bold) { Debugging note } (no space) : tried to draw from an empty quip deck! The current act is (current act $Act) $Act . Please tell Daniel that this happened and how far you feel you’ve gotten in the game. %% TODO remove this eventually!
			}
		(or)
		(stopping)
	(endif)
	(randomly select $NewQuip from $Deck)
	(select quip $NewQuip)

(select quip $NewQuip)
	(now) (current quip $NewQuip)
	(now) ($NewQuip is visited)
	(now) (current quip position 0)
	(now) (delay selection by one tick) %% Add an extra short delay between quips
	(log) { Chose $NewQuip }

($New is discourse-relevant)
	(current quip $Old)
	*($Old involves $Topic)
	($New involves $Topic)

%% The other side of the coin is printing the lines
(show the current quip)
	(no quip this turn) %% Set this flag to silence the quips for one turn
	(now) ~(no quip this turn)
(show the current quip)
	(current quip $Quip) %% Only run if we have a quip
	(current quip position $Old)
	($Old plus 1 into $New)
	(now) (current quip position $New)
	($Quip line $New) %% This will fail if we’ve reached the end

%% And we have to do this every turn

(late on every tick)
	~(current act 0) %% Don’t do this during the tutorial prologue
	~(current act 4) %% Or the epilogue
	(at most once) {
		(show the current quip)
	(or)
		(select a new quip at random)
	}

%% When we change acts, we also want to exhaust the current quip, since in-universe a bunch of time is passing

(exhaust the current quip before changing acts)
	(exhaust) *(show the current quip)
	(select quip #q-actchange)

%% We also don’t want new quips coming in a constant stream, so we have a couple of “null quips” in the rotation
%% null-1 has no lines and immediately replaces itself with a new one
%% null-2 has one blank line before replacing itself
%% Both of them unset their own visited flag so that they can be drawn unlimited times - which also means there’s no edge case when no quips are available

#q-null-1
(quip *)
(locked *) (current quip *) %% Don’t pick it twice in a row
(* line)
	(now) (* is unvisited)
	(fail) %% Draw a new quip immediately

%% We have enough quips now that I don’t think we need this delay
%% #q-null-2
%% (quip *)
%% (* line)
%% 	(now) (* is unvisited)

#q-actchange %% A few turns of silence when changing acts
%% Does not have (quip $) because we don’t want it selected at random
(* line 1)

(understand command [quipdata])
(perform [quipdata])
	(div @meta) {
		(exhaust) {
			*(quip $Q)
			($Q is unvisited)
			$Q
			(if) ($Q is locked) (then)
				(space) - (space) Locked
			(endif)
			(line)
		}
	}
