%% X---D---D---X
%%     |   |
%% T---O---O---S
%% |   |   |   |
%% T---O---O---S
%%     |
%%     O---O---O

(global variable (current act 0)) %% 0 (prologue), 1, 2, 3, 4 (epilogue)
(in bounds for this act $Room)
	(current act $Act)
	($Room is available in act $Act)

#serv1
(room *)
(from * go #east to #gild1)
(* is available in act 4)

(name *) servants' storage
(look *)
	~(#butler is in room *)
	The room is dark and I cannot see much. Someone will need to open the door.
(look *)
	Everything the staff could ever need is stashed here in the narrow space between the walls, from dustpans and twine to curling irons and spare silver trays.

#servantstuff
(name *) various items
(plural *)
(dict *) dustpan dustpans twine curling iron irons spare trays
(* is #in #serv1)
(descr *) It must take all sorts of items to run an event of this scale.

#data
(name *) data drive
(dict *) small
(item *)
(* is #in #serv1)
(appearance *)
	(* is pristine)
	(#butler is #in #serv1) %% Don't show it when just clicking the room, it has to be visited first
	The butler is inclining his head slightly toward a small ({data drive}).
(appearance *)
	(* is handled)
	A small ({data drive}) has been left off to one side.

(descr *)
	The front is entirely blank.
	(if) (* is pristine) (then)
		The other side cannot be seen from its current position.
	(else)
		The other side is marked with a sticky note: "PyramidAI actual strategy plans final_FINAL TOP SECRET CONFIDENTIAL encrypted 1024 bit DO NOT DUPLICATE".
	(endif)

(drive password) p2F5UGN5uhynqP==

#serv2
(room *)
(from * go #west to #gild2)
(* is available in act 4)

(name *) servants' control room
(look *)
	~(#butler is in room *)
	The room is dark and I cannot see much. Someone will need to open the door.
(look *)
	This room must be intended to coordinate dozens of staff at a time. Monitors track every inch of the building, from Jackdaw in the basement to the guests in the dining room. A ({radio system}) delivers alerts from each of them to the employees' wearable electronics. And in case of emergency, an ({intercom}) can transmit to anywhere in the house.

#monitors
(name *) monitors
(dict *) radio system monitor
(plural *)
(* is #in #serv2)
(descr *) This must be how the butler tracked our distractions. If he had been overseeing a proper household staff, we would have stood no chance.
(after [examine *])
	(div @jackdaw) { you don't have to sound so admiring about it }

#intercom
(name *) intercom system
(* is #in #serv2)
(descr *) It can transmit anything to any room in the mansion: voice, video, images, text, and more.
(attend target *)
(after [examine *])
	(div @jackdaw) { just imagine if we had voice here (line) we could hear spider drooling over it }

(perform [attend to #intercom/#data])
	(#butler is in room #serv2)
	(#data is #heldby #butler)
	(div @spider) { The butler is plugging the drive into the intercom and typing in a password: (span @bold) (drive password) . He is setting the output to the dining room. I hear something on that microphone. Switching to it now. }
	(finishing cutscene) %% The end!
(perform [attend to *]) %% Fallback
	(div @spider) { The butler shakes his head very slightly. There is nothing to transmit. }

(prevent entering #serv1/#serv2)
	~(current player #butler) %% Only the butler can go in
	(div @rat) { The rat cannot. The tunnel is on the map. But where? The rat does not see. There is no door. }

#gild1
(room *)
(from * go #south to #grangild)
(from * go #east to #gild2)
(from * go #west to #serv1) (current act 0) (or) (current act 4) %% 0 is when the map is built
(* is available in act 1/2/3/4)

(name *) trophy room
(look *) The gold walls here are mostly covered by steel: ({weapons}) of every shape and kind, trophies of the Count's defeated enemies. The room stretches two stories high and the upper reaches are lost in shadow.

#weapons
(name *) weapons
(dict *) longsword longswords wedding ring rings redistricting map maps claymore claymores wooden peg pegs flimsy battleaxe battle axe
(* is #in #gild1)
(descr *)
	Everything from longswords to wedding rings to redistricting maps to claymores \( both kinds \) , held on the wall by flimsy wooden pegs.
	(if) (* is broken) (then)
		One of those pegs has been knocked loose, setting a battleaxe swinging free at neck height.
	(endif)
(sabotage target *)
(* requires tool #rod) ~(current act 1)

(narrate sabotaging *)
	(div @rat) { Many handholds. The rat can climb. Small pegs. Easy to pull free. And the axe begins to swing! }
	(div @spider) { A battleaxe has come loose and is now swinging around at neck height. }
(narrate fixing *)
	(div @spider) { The butler is swinging a curtain rod with remarkable agility, trying to parry the battleaxe and get its motion under control. Eventually he manages to block its edge and push it carefully back up onto the pegs. }

#rod
(name *) curtain rod
(item *)
(* is #in #gild1)
(descr *) Six feet of metal with a knob on either end, and no curtains in sight.
(appearance *) (* is pristine)
	The newest acquisition seems to be a ({curtain rod}) mounted near the floor.
(appearance *) (* is handled)
	A ({curtain rod}) has been propped up in an out-of-the-way corner.

#gild2
(room *)
(from * go #south to #glasgild)
(from * go #west to #gild1)
(from * go #east to #serv2) (current act 0) (or) (current act 4)
(* is available in act 1/2/3/4)

(name *) gold-plated bathroom
(look *) Everything in the gilded wing is covered in some kind of gold, and the bathrooms are no exception. Even the ({toilet}) is polished to a bright shine.

#toilet
(name *) toilet
(* is #in #gild2)
(descr *)
	Covered in intricate rose-on-electrum designs. How much work must go into keeping this shiny every day?
	(if) (* is broken) (then)
		It is currently spraying water across the room.
	(endif)
(sabotage target *)
(* requires tool #newspaper) ~(current act 1)
(narrate sabotaging *)
	(div @rat) { Gold pipes. Not different from normal pipes. The rat twists, and inserts, and reconnects, and is done. }
	(div @spider) { And water is currently spraying halfway across the room. Good job. }
(narrate fixing *)
	(div @spider) { The butler is kneeling down in the puddle and reconnecting the pipes. Then a few pages of the New Gothenburg Post get repurposed as a mop to transfer the water back into the toilet bowl. }

#newspaper
(name *) newspaper
(dict *) copy of the New Gothenburg Post
(item *)
(* is #in #gild2)
(descr *) From the latest numbers, the New Gothenburg Post is the most popular paper in the city. It is well known for being thick and absorbent, among other good qualities.
(appearance *) (* is pristine)
	The only non-gilded object is the ({newspaper}) supplied for reading.
(appearance *) (* is handled)
	A ({newspaper}) has been pushed unobtrusively into a corner.

#gran1
(room *)
(from * go #east to #grangild)
(from * go #south to #gran2)
(* is available in act 2/3/4)

(name *) chapel %% unlocks #q-2-chapel in quips.dg
(look *) Tall, austere, and dimly-lit—everything a chapel should be. A massive ({pipe organ}) dominates the end of the room and the ({bones}) of countless Vespertilion ancestors look down from niches along the walls.

#bones
(name *) ancestors' bones
(* is #in #gran1)
(descr *) Sightless eyes stare down.

#organ
(name *) pipe organ
(* is #in #gran1)
(sabotage target *)
(* requires tool #tray)
(descr *)
	The design is as plain and functional as possible, to convey that this million-dollar musical instrument is a tool, not a luxury.
	(if) (* is broken) (then)
		It is currently blasting out a
		(if) (organ note is low) (then)
			low, rumbling
		(else)
			high, piercing
		(endif)
		(organ note $Note)
		(note name for $Note)
		.
	(endif)

(narrate sabotaging *)
	(random from 1 to 5 into $Note)
	(now) (organ note $Note)
	(if) (random from 1 to 2 into 1) (then)
		(now) (organ note is low)
	(else)
		(now) ~(organ note is low)
	(endif)
	(div @rat) { The rat is small. The rat moves inside. The belly of the machinery. Valves to open. Switches to twist. And the noise begins! }
	(div @chameleon) {
		I believe that is a
		(if) (organ note is low) (then)
			(select) bass (or) low (or) bottom (purely at random)
		(else)
			(select) treble (or) high (or) top (purely at random)
		(endif)
		(note name for $Note) ?
	}

(narrate fixing *)
	(div @spider) { The butler forces his way toward the organ as if he is fighting a strong current. Using the silver tray he is able to cover two of the valves with one hand; his other hand covers a third, and he pushes the switch with his mouth. Silence rings out. }

(global variable (organ note $))
(note name for 1)
	C-flat
(note name for 2)
	E-quarter-tone-sharp
(note name for 3)
	F-double-flat
(note name for 4)
	A-quarter-tone-flat
(note name for 5)
	B-double-sharp

#gran2
(room *)
(from * go #east to #dine1)
(from * go #north to #gran1)
(* is available in act 2/3/4)

(name *) batcote %% unlocks q-2-batcote
(look *) This was probably a dovecote in the past. But without the need for messenger pigeons, the nest holes have been filled with ({cages}), and the cages filled with dozens and dozens of bats.

#cages
(name *) bat cages
(dict *) cage bats
(plural *)
(* is #in #gran2)
(descr *)
	The bats are almost invisible in the darkness, but the squeaking suggests there are (span @italic) many .
	(if) (* is broken) (then)
		Several of them are now swooping overhead.
	(endif)
(sabotage target *)
(* requires tool #rod)

(narrate sabotaging *)
	(div @rat) { Simple cages. Many handholds to climb. The latches open, and open, and open. }
(narrate fixing *)
	(div @spider) { The butler has attached a cage to the end of the curtain rod and is swinging it around, trying to recapture the bats. It is not an easy process, but the bats seem used to it and are easily subdued. }

(prevent entering #gran1/#gran2)
	(current act 1)
	(div @chameleon) { Careful there! }
	(div @rat) { Occupied? }
	(div @chameleon) { The Count is likely moving around in the Granite Wing. }
	(div @jackdaw) { is he harder to avoid than the butler? }
	(div @spider) { He should not be, no. }
	(div @chameleon) { But if he's alerted to sabotage before the party starts, he might change his plans. }
	(div @jackdaw) { point }

#glas1 %% has quip in quips.dg
(room *)
(from * go #west to #glasgild)
(from * go #south to #glas2)
(* is available in act 2/3/4)

(name *) server room
(look *) Racks of machinery cover every wall and pile up in floor-to-ceiling pillars, all enmeshed in a web of ({coolant pipes}).

#coolant
(name *) coolant pipes
(dict *) pipe web of
(plural *)
(* is #in #glas1)
(descr *)
	Servers produce heat, and these pipes are supposed to move that heat out of the building and make it someone else's problem. The wall thermometer reads 15 Celsius, so it seems to be working
	(if) (* is broken) (then)
		(no space)—the pool of chemicals on the floor notwithstanding
	(endif)
	.
(sabotage target *)
(* requires tool #newspaper)

(narrate sabotaging *)
	(div @rat) { So many pipes. So many connections. Pry one free, and let its lifeblood flow and pool. }
(narrate fixing *)
	(div @spider) { The butler is fiddling with valves and connectors to isolate the leaking section of pipe, then mopping up the freon puddles with a few more pages of the Post. }

#glas2 %% has quip in quips.dg
(room *)
(from * go #west to #dine2)
(from * go #north to #glas1)
(* is available in act 2/3/4)

(name *) office
(look *) It looks like a college dorm room. A desk, a bed, a window, and a closet. According to Chameleon, though, all of this is specially commissioned from top designers and rigged from floor to ceiling with ({smart automation devices}).

#devices
(name *) smart automation devices
(dict *) device
(plural *)
(* is #in #glas2)
(descr *)
	Every inch of the room is filled with sensors: light, pressure, temperature, and more.
	(if) (* is broken) (then)
		Those sensors are currently causing a bizarre series of reactions in the room.
	(endif)
(sabotage target *)
(* requires tool #tray)

(narrate sabotaging *)
	(div @rat) { The sensors. They can be confused. Report errors. The system will lose consistency. }
	(div @spider) { I am seeing the spikes now. Complete darkness in the room; blazing light in the closet. High-temperature air blowing from the bed. }
(narrate fixing *)
	(div @spider) { The butler is working on the office devices now. With the silver tray he can reflect light from the closet onto the right sensors, and everything is slowly coming back into alignment. }

(prevent entering #glas1/#glas2)
	(current act 1)
	(div @chameleon) { Careful there! }
	(div @rat) { Occupied? }
	(div @chameleon) { LLM is likely moving around in the Glass Wing. }
	(div @jackdaw) { is she harder to avoid than the butler? }
	(div @spider) { She should not be, no. }
	(div @chameleon) { But if she's alerted to sabotage before the party starts, she might change her plans. }
	(div @jackdaw) { point }

#grangild
(room *)
(from * go #west to #gran1)
(from * go #north to #gild1)
(from * go #east to #glasgild)
(from * go #south to #dine1)
(* is available in act 1/2/3/4)
(default butler room for act 1 is *) %% Alternate between the rooms
	(butler alternator is set) %% See ai.dg for explanation

(name *) granite-gilded passage
(look *) Four corridors join here at a small hub, where the huge stone blocks of the Granite Wing to the west clash with the too-shiny ornaments of the Gilded Wing to the north.

#glasgild
(room *)
(from * go #east to #glas1)
(from * go #north to #gild2)
(from * go #west to #grangild)
(from * go #south to #dine2)
(* is available in act 1/2/3/4)
(default butler room for act 1 is *)
	(butler alternator is unset)

(name *) glass-gilded passage
(look *) Four corridors join here at a small hub, where the sharp-edged rectangles of the Glass Wing to the east clash with the too-shiny ornaments of the Gilded Wing to the north.

(early on every tick) %% Comment on the wing names
	(#rat is in room $Room)
	($Room is one of [#grangild #glasgild])
	(accumulate 1)
		(#grangild is visited) (or) (#glasgild is visited)
	(into $N) %% How many of the wings are visited?
	(if) ($N = 1) (then) %% Visiting the first one
		(select)
			(div @jackdaw) { do both of them really need to start with g }
			(div @chameleon) { It does seem like there could have been more...(no space) (span @italic) creativity involved. }
			(div @rat) { It fits. The names match. A symmetry. }
			(div @jackdaw) { we could even just call them north east and west (line) i thought you loved compass directions }
			(now) (no quip this turn)
		(or)
		(stopping)
	(elseif) ($N = 2) (then) %% Visiting the second one
		(select)
			(div @jackdaw) { granite gilded glass (line) seriously }
			(div @chameleon) { Why not Gothic, Rococo, and Modernist? }
			(div @jackdaw) { modernist covers so much though (line) this is specifically international style (line) and this is too much gold even for rococo }
			(div @chameleon) { Gothenburg Neo-Rococo, perhaps? }
			(div @spider) { Let us use the existing names for this mission. }
			(div @jackdaw) { oh no are these words not in your compression dictionary? }
			(now) (no quip this turn)
		(or)
		(stopping)
	(endif)

#dine1
(room *)
(from * go #west to #gran2)
(from * go #north to #grangild)
(from * go #east to #dine2)
%% No connection south, since you never go back out there
(* is available in act 0/1/2/3/4)
(butler-only *) (current act 2)
(default butler room for act 2/3/4 is *)
	~(butler needs to greet chameleon) %% see below
	(butler alternator is set)
(default butler room for act 3 is $Room) %% quips.dg
	(butler needs to greet chameleon)
	(#chameleon is in room $Room)

(name *) dining patio
(look *) Half inside, half outside, with no door in between. The north end of the patio is surrounded by the other rooms of the mansion, while the south end with the ({piano}) is in the middle of the garden. Maintaining a consistent temperature must cost a fortune.

#piano
(name *) piano
(* is #in #dine1)
(descr *)
	~(current act 1)
	The electronics have been locked down to prevent any further sabotage.
(descr *)
	No entertainer has been booked for tonight, but the electronics in the piano claim they can replicate any virtuoso's finest performance.
	(if) (* is broken) (then)
		They are currently replicating something else entirely.
	(endif)
(sabotage target *) (current act 1)
(narrate sabotaging *)
	(div @rat) { It will play. But what? }
	(select)
		(div @chameleon) { The Wrong Note Etude. }
	(or)
		(div @spider) { Rick Astley. }
	(or)
		(div @jackdaw) { every note all at the same time max volume over and over }
	(at random)
	(div @rat) { It is done. }
(narrate fixing *)
	(div @spider) { The butler flips a switch under the piano and it falls silent. }

#tray
(name *) silver tray
(item *)
(descr *) The traditional tool of a butler.
(* is #in #dine1)
(appearance *) (* is pristine) A ({silver tray}) sits on top of the piano.
(appearance *) (* is handled) A ({silver tray}) has been stowed discreetly in a corner.

#dine2
(room *)
(from * go #east to #glas2)
(from * go #north to #glasgild)
(from * go #west to #dine1)
(* is available in act 1/2/3/4)
(butler-only *) (current act 2)
(default butler room for act 2/3/4 is *)
	~(butler needs to greet chameleon)
	(butler alternator is unset)

(name *) ballroom
(look *) The eastern half of the dining area is properly enclosed, but with floor-to-ceiling windows along the south wall to keep it connected to the gardens. During the day, it is well-lit with sunlight; at night, the ({chandelier}) fills in.

#chandelier
(name *) chandelier
(dict *) crank ratchet
(* is #in #dine2)
(descr *)
	~(current act 1)
	The crank has been removed to prevent any further sabotage.
(descr *)
	A crank in one corner controls the height, currently
	(if) (* is broken) (then)
		four feet off the ground
	(else)
		high overhead
	(endif)
	.
(sabotage target *) (current act 1)
(narrate sabotaging *)
	(div @rat) { The crank is on a ratchet. The rat trips it, and. Voila! }
	(div @chameleon) { What was that sound?! }
	(div @spider) { That was the chandelier crashing down and landing on the tables. }
(narrate fixing *)
	(div @spider) { The butler laboriously cranks the chandelier back up to the ceiling and fixes the ratchet in place. }

